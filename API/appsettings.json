{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Model.Validation": "Error",
      "LuckyPennySoftware.MediatR.License": "Error",
      "Infrastructure.MlApi": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=vakansio;Username=postgres;Password=postgres;No Reset On Close=true;Pooling=false"
  },
  "Jwt": {
    "Issuer": "Vacancies",
    "Audience": "VacanciesUsers",
    "ExpiryDays": 7
  },
  "Eval": {
    "ResultsRoot": "../results"
  },
  "S3": {
    "Region": "eu-central-1"
  },
  "Ml": {
    "EnableEmbedding": false,
    "EnableEmbeddingWorker": false
  },
  "BackgroundWorkers": {
    "EnableCacheRetention":   true,
    "EnableDescriptionRetry": true
  },
  "CacheRetention": {
    "UserSearchSnapshotDays": 30,
    "ScoringCacheDays":       90,
    "GeminiCostLogDays":      180,
    "AuditEntryDays":         365
  },
  "DescriptionRetry": {
    "RetryIntervalMinutes": 60,
    "BatchSize":             25,
    "MaxAgeDays":             7
  },
  "LangSmith": {
    "Enabled": true,
    "Project": "vakansio",
    "Endpoint": "https://api.smith.langchain.com"
  },
  "Calibration": {
    "RecruiterPath": "Calibrators/recruiter_latest.json"
  },
  "Sentry": {
    "Debug": false,
    "TracesSampleRate": 0,
    "MaxRequestBodySize": "Small",
    "SendDefaultPii": false,
    "AttachStacktrace": true
  },
  "Gemini": {
    "RetryCount": 3
  }
}
